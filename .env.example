# Database. Defaults to a local SQLite file for zero-setup dev.
# For PostgreSQL: postgresql+psycopg2://wajz:wajz@localhost:5432/wajz
DATABASE_URL=sqlite:///./wajz.db

# Auth mode: "dev" enables POST /auth/dev-login (local development only).
# "supabase" verifies asymmetric JWTs against Supabase JWKS. Legacy HS256
# projects are verified through the Supabase Auth API.
AUTH_MODE=dev
SECRET_KEY=change-me-to-a-long-random-string
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUDIENCE=authenticated
ADMIN_OWNER_EMAIL=owner@wajz.app
ADMIN_REQUIRE_MFA=false
ADMIN_ORIGIN=http://127.0.0.1:4173

# Explicit browser origins allowed to call the API.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:4173

# Observability. Leave external exporters blank to disable them locally.
ENVIRONMENT=development
RELEASE=0.1.0
# Protects GET /metrics when set (send as X-Metrics-Token).
METRICS_TOKEN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Example: https://otel-collector.example.com:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=

# AI processing. AI_PROVIDER may be auto, anthropic, gemini, zai, or heuristic.
# In auto mode the priority is Anthropic, Gemini, then Z.AI.
# With neither key, the deterministic extractive summarizer is used.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ZAI_API_KEY=
ZAI_MODEL=glm-4.5-air
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# Comma-separated languages generated and stored for each story.
CONTENT_LANGUAGES=en,ar
# Target languages generated by the translation workers. Arabic is the
# production default; source-language snapshots are stored automatically.
TRANSLATION_LANGUAGES=ar
TRANSLATION_BATCH_SIZE=50

# Worker
INGESTION_INTERVAL_MINUTES=30
ADMIN_JOB_POLL_SECONDS=5

# Versioned mandatory privacy notice and first-party analytics retention.
PRIVACY_POLICY_VERSION=2026-08-13
ANALYTICS_RAW_RETENTION_DAYS=90
ANALYTICS_AGGREGATE_RETENTION_DAYS=396

# Rate limiting (requests per window per client IP)
RATE_LIMIT_PUBLIC=120
RATE_LIMIT_AUTH=20
RATE_LIMIT_ADMIN=120
RATE_LIMIT_ANALYTICS=240
RATE_LIMIT_WINDOW_SECONDS=60
