# Database. Defaults to a local SQLite file for zero-setup dev.
# For PostgreSQL: postgresql+psycopg2://wajz:wajz@localhost:5432/wajz
DATABASE_URL=sqlite:///./wajz.db

# Auth mode: "dev" enables POST /auth/dev-login (local development only).
# "supabase" verifies Supabase-issued JWTs with SUPABASE_JWT_SECRET.
AUTH_MODE=dev
SECRET_KEY=change-me-to-a-long-random-string
SUPABASE_JWT_SECRET=

# Admin endpoints require this token in the X-Admin-Token header.
ADMIN_TOKEN=change-me-admin-token
# Comma-separated accounts bootstrapped as super_admin on login.
ADMIN_EMAILS=admin@wajz.app
# Explicit browser origins allowed to call the API.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3002,http://localhost:3002

# Observability. Leave external exporters blank to disable them locally.
ENVIRONMENT=development
RELEASE=0.1.0
# Protects GET /metrics when set (send as X-Metrics-Token).
METRICS_TOKEN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Example: https://otel-collector.example.com:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=

# AI processing. AI_PROVIDER may be auto, anthropic, zai, or heuristic.
# In auto mode Anthropic is preferred when both keys are set, then Z.AI.
# With neither key, the deterministic extractive summarizer is used.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
ZAI_API_KEY=
ZAI_MODEL=glm-4.5-air
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# Comma-separated languages generated and stored for each story.
CONTENT_LANGUAGES=en,ar

# Worker
INGESTION_INTERVAL_MINUTES=30

# Rate limiting (requests per window per client IP)
RATE_LIMIT_PUBLIC=120
RATE_LIMIT_AUTH=20
RATE_LIMIT_WINDOW_SECONDS=60
