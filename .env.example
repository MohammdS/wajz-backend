# Database. Defaults to a local SQLite file for zero-setup dev.
# For PostgreSQL: postgresql+psycopg2://wajz:wajz@localhost:5432/wajz
DATABASE_URL=sqlite:///./wajz.db

# Auth mode: "dev" enables POST /auth/dev-login (local development only).
# "supabase" verifies Supabase-issued JWTs with SUPABASE_JWT_SECRET.
AUTH_MODE=dev
SECRET_KEY=change-me-to-a-long-random-string
SUPABASE_JWT_SECRET=

# Admin endpoints require this token in the X-Admin-Token header.
ADMIN_TOKEN=change-me-admin-token

# AI processing. When ANTHROPIC_API_KEY is unset the pipeline falls back to a
# deterministic extractive summarizer so the app still works end to end.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# Worker
INGESTION_INTERVAL_MINUTES=30

# Rate limiting (requests per window per client IP)
RATE_LIMIT_PUBLIC=120
RATE_LIMIT_AUTH=20
RATE_LIMIT_WINDOW_SECONDS=60
