WAJZ_API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg2://wajz:replace-with-url-encoded-password@db:5432/wajz

ENVIRONMENT=production
RELEASE=0.1.0
AUTH_MODE=supabase
SECRET_KEY=replace-with-at-least-32-random-bytes
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
SUPABASE_AUDIENCE=authenticated
ADMIN_EMAILS=admin@example.com
CORS_ORIGINS=https://app.example.com,https://admin.example.com
METRICS_TOKEN=replace-with-a-random-monitoring-token

AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
ZAI_API_KEY=
ZAI_MODEL=glm-4.5-air
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
CONTENT_LANGUAGES=en,ar
TRANSLATION_LANGUAGES=ar
TRANSLATION_BATCH_SIZE=50

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
INGESTION_INTERVAL_MINUTES=30
